# Copy this file to .env and fill in your own key:
#   cp .env.example .env
# .env is git-ignored, so your key never gets committed.

# Mistral API key, from https://console.mistral.ai/api-keys
# (needs pay-as-you-go enabled; the free tier allows only 2 requests per minute)
MISTRAL_API_KEY=your-mistral-api-key-here
